# Copy this file to .env and fill in real values before running the app.

# Prisma / SQLite database file location (relative to project root).
DATABASE_URL="file:./dev.db"

# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Seed admin account (used by prisma/seed.ts to create the first admin user).
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# WhatsApp business number in international format, without a leading +.
NEXT_PUBLIC_SHREE_BANGLES_WHATSAPP_NUMBER=""
